# Salin file ini menjadi ".env" lalu isi dengan data asli.
# JANGAN pernah menampilkan file .env (yang sudah terisi) di layar saat syuting/screen-recording.

# --- ROUTER (wajib) ---
ROUTER_IP=192.168.88.1
ROUTER_USER=admin
ROUTER_PASS=ganti_dengan_password_asli

# --- Protokol koneksi REST API ---
# RouterOS < 7.9: WAJIB https (true). RouterOS >= 7.9: http juga bisa (false).
# Cek versi Anda: /system resource print -> lihat baris "version".
USE_HTTPS=true
# VERIFY_SSL=false berarti sertifikat self-signed diterima (wajar untuk lab).
# Ubah ke true HANYA jika Anda memasang sertifikat valid/trusted di router.
VERIFY_SSL=false

# --- SWITCH (opsional) ---
# Kosongkan SWITCH_IP jika belum ingin memonitor switch secara terpisah.
# Switch harus punya IP management sendiri yang bisa diakses REST API.
SWITCH_IP=
SWITCH_USER=admin
SWITCH_PASS=ganti_dengan_password_asli

# --- Nama interface WAN (internet) dan trunk (ke switch) di ROUTER ---
# Sesuaikan dengan konfigurasi topologi Anda.
WAN_INTERFACE_NAME=ether1
TRUNK_INTERFACE_NAME=ether5

# --- Ollama (AI lokal) ---
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_URL=http://localhost:11434/api/chat

# --- Target demo untuk menu "VLAN Health" ---
DEMO_SOURCE_VLAN=30
DEMO_DEST_VLAN=40
DEMO_DEST_IP=10.10.40.10
